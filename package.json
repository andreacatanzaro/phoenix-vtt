{
  "name": "phoenix-vtt",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "docker compose up",
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p scripts/tsconfig.json",
    "lint": "eslint .",
    "coverage:content": "tsx scripts/coverage-content.ts",
    "coverage:check": "tsx scripts/coverage-content.ts --check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@phoenix/content": "workspace:*",
    "@phoenix/rules-srd": "workspace:*",
    "@phoenix/shared": "workspace:*",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
